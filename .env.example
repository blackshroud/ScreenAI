# ========================================
# ScreenCopilot - Environment Configuration
# ========================================
# Copy this file to .env and fill in your values.
# This file stores sensitive credentials. Do not commit .env to version control.

# ----- API Keys -----
# Deepgram API key for speech-to-text (only used when you press "Listen").
# Get your key from: https://console.deepgram.com/
DEEPGRAM_API_KEY="your_deepgram_api_key_here"

# ----- Logging -----
# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ----- Development Mode -----
# true = the window is NOT hidden from screen capture, and debug output is enabled.
DEV_MODE=false

# ----- AI Behaviour -----
TRACK_USER_RESPONSES=true
INCLUDE_CONVERSATION_HISTORY=true
MAX_CONVERSATION_HISTORY=6
# false = short, direct answers
GENERATE_FULL_ANSWERS=true
# false = do not add learned memory to prompts
PERSONALIZE_ANSWERS=true

# ----- Learning & Suggestions -----
ENABLE_LEARNING=true
ENABLE_SUGGESTIONS=true
ENABLE_AUTOMATION_DETECTION=true
MAX_TASK_HISTORY=200

# ----- Scroll Speed (Alt+Up/Down) -----
# Pixels per scroll tick - higher = faster scroll
SCROLL_SPEED_PX=150
# Milliseconds between scroll ticks while the key is held - lower = faster
SCROLL_INTERVAL_MS=50
